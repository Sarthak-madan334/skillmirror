NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://skillmirror:change-me@localhost:5432/skillmirror?schema=public
FRONTEND_ORIGIN=http://localhost:5173
MEDIA_STORAGE_DIR=./backend/storage
MEDIA_STORAGE_DRIVER=local
MEDIA_RETENTION_DAYS=365
# For a durable private S3-compatible bucket, configure:
# MEDIA_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# S3_BUCKET=skillmirror-media
# S3_ACCESS_KEY_ID=<bucket-scoped-key>
# S3_SECRET_ACCESS_KEY=<secret>
# Optional. Keep this secret on the backend; never add it to a VITE_* variable.
# Optional. Set GROQ_API_KEY in this backend environment to enable AI features.
GROQ_MODEL=qwen/qwen3.8-27b
